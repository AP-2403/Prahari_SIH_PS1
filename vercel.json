{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "prahari/backend",
      "framework": "fastapi"
    },
    "prahari-frontend": {
      "root": "prahari/prahari-frontend",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/audio/(.*)",
      "destination": {
        "service": "prahari-frontend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "prahari-frontend"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "prahari-frontend"
      }
    },
    {
      "source": "/favicon.png",
      "destination": {
        "service": "prahari-frontend"
      }
    },
    {
      "source": "/prahari-emblem.png",
      "destination": {
        "service": "prahari-frontend"
      }
    },
    {
      "source": "/icons.svg",
      "destination": {
        "service": "prahari-frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "prahari-frontend",
        "path": "/"
      }
    }
  ]
}
